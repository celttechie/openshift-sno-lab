# ==============================================================================
# SNO Split-DNS Configuration (dnsmasq)
# Generated by Ansible for OpenShift Peer Bastion
# ==============================================================================

# Listen interfaces and addresses
listen-address=127.0.0.1,{{ bastion_ip }}
bind-interfaces

# Domain configuration
domain={{ network_domain }}
expand-hosts
domain-needed
bogus-priv

# Upstream DNS Resolvers
no-resolv
server={{ network_gateway }}
server=1.1.1.1
server=8.8.8.8

# Cluster Node Static Entries
address=/bastion/{{ bastion_ip }}
address=/bastion.{{ network_domain }}/{{ bastion_ip }}
address=/sno-node/{{ sno_ip }}
address=/sno-node.{{ network_domain }}/{{ sno_ip }}

# OpenShift API & Machine-Config Endpoints
address=/api.{{ network_domain }}/{{ sno_ip }}
address=/api-int.{{ network_domain }}/{{ sno_ip }}

# OpenShift Ingress Wildcard Domain
address=/.apps.{{ network_domain }}/{{ sno_ip }}
